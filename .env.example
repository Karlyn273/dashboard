# Neon Postgres connection string
# Get this from your Neon project dashboard → Connection Details
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Anthropic API key — used server-side only to generate daily devotional reflections
ANTHROPIC_API_KEY=sk-ant-...

# Google Calendar OAuth 2.0
# Create credentials at console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# Your app's public base URL — used to build the OAuth callback redirect URI.
# Local development:  http://localhost:3000
# Vercel production:  https://your-app.vercel.app  (or custom domain)
BASE_URL=http://localhost:3000
